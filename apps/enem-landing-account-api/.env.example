PORT=3000
CORS_ORIGIN=http://localhost:4000,http://localhost:8000

# Aiven MySQL (or local MySQL in dev) — see issues/10-infra-cicd.md
DATABASE_URL=mysql://user:user@localhost:3306/enem_landing_account

# Upstash Redis (or local Redis in dev) — see libs/backend/redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=172800

# Keep false outside of dev/staging — see Story 03 (issues/03-enem-landing-account-api.md)
ALLOW_SIGNUP=false

# Cloudflare R2 (S3-compatible) for the uploads feature. These are only the
# fallback — the source of truth is the `system_settings` table, editable
# from enem-landing-cms's settings page (Story 07) via SystemSettingsService.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
