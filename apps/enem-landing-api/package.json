{
  "name": "enem-landing-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/enem-landing-api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/enem-landing-api/dist/package.json",
          "{workspaceRoot}/apps/enem-landing-api/dist/yarn.lock"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/enem-landing-api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "enem-landing-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "enem-landing-api:build:development"
          },
          "production": {
            "buildTarget": "enem-landing-api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "build-cli": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "tsc --project tsconfig.cli.json",
          "cwd": "apps/enem-landing-api"
        }
      },
      "migration:run": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build-cli"
        ],
        "options": {
          "command": "node ../../node_modules/typeorm/cli.js migration:run -d dist-cli/database/data-source.js",
          "cwd": "apps/enem-landing-api"
        }
      },
      "migration:revert": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build-cli"
        ],
        "options": {
          "command": "node ../../node_modules/typeorm/cli.js migration:revert -d dist-cli/database/data-source.js",
          "cwd": "apps/enem-landing-api"
        }
      },
      "seed": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build-cli"
        ],
        "options": {
          "command": "node dist-cli/database/seed.js",
          "cwd": "apps/enem-landing-api"
        }
      },
      "lint:format": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --check 'apps/enem-landing-api/src/**/*.ts'"
          ]
        }
      },
      "lint:format:fix": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --write 'apps/enem-landing-api/src/**/*.ts'"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@enem-landing/backend-cache": "0.0.1",
    "@enem-landing/backend-redis": "0.0.1",
    "@enem-landing/backend-scheduler": "0.0.1",
    "@enem-landing/backend-sso": "0.0.1",
    "@enem-landing/backend-utils": "0.0.1",
    "@enem-landing/shared-definitions": "0.0.1",
    "@enem-landing/shared-types": "0.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "mysql2": "^3.24.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.31",
    "typeorm-extension": "^3.9.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6"
  }
}
