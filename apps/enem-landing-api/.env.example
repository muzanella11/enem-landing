PORT=3001
CORS_ORIGIN=http://localhost:4000,http://localhost:8001

# Aiven MySQL (or local MySQL in dev) — see issues/10-infra-cicd.md
DATABASE_URL=mysql://user:user@localhost:3306/enem_landing_api

# Upstash Redis (or local Redis in dev) — see libs/backend/redis. Backs the
# public-endpoint response cache (libs/backend/cache); the app still works
# without it, just uncached.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=

# Base URL of enem-landing-account-api — used by SsoAuthGuard (libs/backend/sso)
# to validate tokens on admin endpoints.
ACCOUNT_API_HOST=http://localhost:3000

# Sent as X-Internal-Api-Key when uploading session-recording chunks to
# enem-landing-account-api's internal uploads endpoint (TrackingRecordingService)
# — must match that app's own INTERNAL_API_KEY exactly. Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=change-me-in-production

# Rate limit for every endpoint (@enem-landing/backend-rate-limit).
# Multiplies all limits - leave unset (1) in production; e2e runs that fire
# many requests from one IP use a large value. RATE_LIMIT_DISABLED=true
# turns it off completely (never in production).
RATE_LIMIT_MULTIPLIER=1
RATE_LIMIT_DISABLED=false

# Slider captcha on the contact form. Only e2e runs set this to false
# (a test can't solve the puzzle); keep it on everywhere else.
CAPTCHA_ENABLED=true
