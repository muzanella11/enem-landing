{
  "name": "enem-landing-web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "lint:format": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --check 'apps/enem-landing-web/{app,server}/**/*.{ts,vue}'"
          ]
        }
      },
      "lint:format:fix": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --write 'apps/enem-landing-web/{app,server}/**/*.{ts,vue}'"
          ]
        }
      },
      "prepare": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/nuxt.config.ts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/.nuxt"
        ],
        "options": {
          "command": "nuxt prepare",
          "cwd": "apps/enem-landing-web"
        }
      },
      "test": {
        "dependsOn": [
          "prepare"
        ]
      }
    }
  },
  "dependencies": {
    "@enem-landing/frontend": "0.0.1",
    "@enem-landing/shared-definitions": "0.0.1",
    "@enem-landing/shared-types": "0.0.1",
    "@enem-landing/shared-utils": "0.0.1",
    "@vee-validate/nuxt": "4.15.1",
    "@vee-validate/zod": "4.15.1",
    "quill-delta-to-html": "^0.12.1",
    "rrweb": "^2.1.1",
    "sanitize-html": "^2.17.7",
    "vee-validate": "4.15.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1"
  }
}
