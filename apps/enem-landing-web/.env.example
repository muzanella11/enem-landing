# Server-only - the BFF routes (server/api/**) call this, the browser
# never sees it.
API_HOST=http://localhost:3001

# Read at nuxt.config.ts build time, not sensitive (ships to every
# browser via the injected gtag.js snippet) - ported from the old site's
# tracking ID. Leave empty locally to skip injecting the script entirely.
GOOGLE_ANALYTICS_ID=UA-83375408-1
