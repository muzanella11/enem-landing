PORT=8002

# Server-only - the BFF routes (server/api/**) call this, the browser
# never sees it.
API_HOST=http://localhost:3001

# Public canonical origin used for canonical URLs, sitemap, and JSON-LD.
NUXT_PUBLIC_SITE_URL=http://localhost:8002

# AdSense ad unit ids per placement (Story 20). The publisher id
# (ca-pub-...) and the on/off switches come from the CMS; leave these empty
# until AdSense approves the site - empty means the slot renders nothing.
NUXT_PUBLIC_ADSENSE_SLOT_RESULT=
NUXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
