{
  "name": "enem-landing-tools",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "lint:format": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --check 'apps/enem-landing-tools/{app,server}/**/*.{ts,vue}'"
          ]
        }
      },
      "lint:format:fix": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --write 'apps/enem-landing-tools/{app,server}/**/*.{ts,vue}'"
          ]
        }
      },
      "generate-og": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/generate-og-images.mjs",
          "{projectRoot}/shared/tools-registry.ts",
          "{projectRoot}/app/data/upah-minimum/index.ts",
          {
            "externalDependencies": [
              "satori",
              "@resvg/resvg-js",
              "@fontsource/inter"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/public/og"
        ],
        "options": {
          "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-og-images.mjs",
          "cwd": "apps/enem-landing-tools"
        }
      },
      "build": {
        "dependsOn": [
          "generate-og",
          "^build"
        ]
      },
      "serve": {
        "dependsOn": [
          "generate-og"
        ]
      },
      "prepare": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/nuxt.config.ts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/.nuxt"
        ],
        "options": {
          "command": "nuxt prepare",
          "cwd": "apps/enem-landing-tools"
        }
      },
      "test": {
        "dependsOn": [
          "prepare"
        ]
      }
    }
  },
  "dependencies": {
    "@enem-landing/frontend": "0.0.1",
    "@enem-landing/shared-definitions": "0.0.1",
    "@enem-landing/shared-types": "0.0.1",
    "@enem-landing/shared-utils": "0.0.1"
  }
}
