PORT=4000

# Server-only — the BFF routes (server/api/**) call these, the browser
# never sees them.
API_HOST=http://localhost:3001
ACCOUNT_API_HOST=http://localhost:3000

# Public — used client-side by useAuthGuard to build the signin redirect
# URL, and by useAuthCookie to set the shared-domain cookie.
ACCOUNT_WEB_HOST=http://localhost:8000

# Empty in dev (cookies aren't port-scoped on localhost). Set to the parent
# domain in prod, e.g. ".muzanella.com" — see Story 04/10.
SHARED_COOKIE_DOMAIN=
