PORT=4003

# Server-only: the BFF routes (server/api/**) call these, the browser never
# sees them.
MONITOR_API_HOST=http://localhost:3003
ACCOUNT_API_HOST=http://localhost:3000

# Public: used by useAuthGuard to build the signin redirect URL, and by
# useAuthCookie for the shared-domain cookie.
ACCOUNT_WEB_HOST=http://localhost:8000
SHARED_COOKIE_DOMAIN=

# CMS link on the Alerts page (email settings live there).
CMS_HOST=http://localhost:4000
