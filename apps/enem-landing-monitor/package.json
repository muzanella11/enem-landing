{
  "name": "enem-landing-monitor",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "lint:format": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --check 'apps/enem-landing-monitor/{app,server}/**/*.{ts,vue}'"
          ]
        }
      },
      "lint:format:fix": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prettier --write 'apps/enem-landing-monitor/{app,server}/**/*.{ts,vue}'"
          ]
        }
      },
      "prepare": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/nuxt.config.ts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/.nuxt"
        ],
        "options": {
          "command": "nuxt prepare",
          "cwd": "apps/enem-landing-monitor"
        }
      },
      "test": {
        "dependsOn": [
          "prepare"
        ]
      }
    }
  },
  "dependencies": {
    "@enem-landing/frontend": "0.0.1",
    "@enem-landing/shared-definitions": "0.0.1",
    "@enem-landing/shared-types": "0.0.1",
    "@enem-landing/shared-utils": "0.0.1"
  }
}
