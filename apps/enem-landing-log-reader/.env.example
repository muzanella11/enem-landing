PORT=3004

# Shared secrets accepted in the X-Log-Reader-Token header, comma separated
# (prod and dev monitor-api each have their own, at least 32 characters).
# On the VPS they come from LOG_READER_TOKENS_FILE instead.
LOG_READER_TOKENS=
LOG_READER_TOKENS_FILE=

# Read-only host mounts in the container. Point them at fixture folders for
# local runs (see apps/enem-landing-monitor-e2e/fixtures/host).
LOG_READER_VAR_LOG_DIR=/host/var/log
LOG_READER_CONTAINERS_DIR=/host/docker/containers
LOG_READER_MYSQL_LOGS_DIR=/host/mysql-logs
LOG_READER_PASSWD_FILE=/host/etc/passwd

# Metrics (Story 66) and MySQL sizes (Story 69). /proc inside the container
# already shows the host numbers; cgroup and the MySQL data dir are
# read-only mounts. Point them at fixtures for local runs.
LOG_READER_PROC_DIR=/proc
LOG_READER_CGROUP_DIR=/host/cgroup
LOG_READER_MYSQL_DATA_DIR=/host/mysql-data
