PORT=3003

# Base URL of enem-landing-account-api, used by SsoAuthGuard
# (libs/backend/sso) to validate the SuperAdmin's token.
ACCOUNT_API_HOST=http://localhost:3000

# Redis: rate limit store and the Redis menu's SLOWLOG. Same instance as the
# other apps; keys get their own prefix (`monitor`, `dev:monitor` on the VPS).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=monitor

# Shown on the overview page (prod/dev/local).
MONITOR_ENV=local

# enem-landing-log-reader (internal service). The token must be one of the
# reader's LOG_READER_TOKENS, at least 32 characters. Logs are off without
# it, or with LOGS_ENABLED=false.
LOG_READER_HOST=http://localhost:3004
LOG_READER_TOKEN=
LOGS_ENABLED=true

RATE_LIMIT_MULTIPLIER=1
RATE_LIMIT_DISABLED=false

# enem-landing-api of this environment: Redis > Cache tab and uptime check.
API_HOST=http://localhost:3001

# Alerts. Email is sent by enem-landing-account-api (POST
# /email/internal/monitor-alert) with the same INTERNAL_API_KEY as the
# contact form; SMTP and the recipient live in CMS Settings. Only prod sets
# ALERTS_EMAIL_ENABLED=true; elsewhere alerts are only recorded.
INTERNAL_API_KEY=
ALERTS_EMAIL_ENABLED=false
# Base URL for links in alert emails.
MONITOR_PUBLIC_URL=http://localhost:4003
# Prod only: samples host metrics and deploy history for both monitors.
MONITOR_PRIMARY=false
# Per-minute jobs (alerts, uptime, metrics). false in unit tests.
SCHEDULER_ENABLED=true
# Webhooks for scripts on the VPS, `id:key` comma separated (key >= 32 chars).
ALERT_WEBHOOKS=
# enem_monitor MySQL user (PROCESS only). Empty = MySQL stats off.
DATABASE_URL_MONITOR=
