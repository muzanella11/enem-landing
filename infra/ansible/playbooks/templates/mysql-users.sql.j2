-- Rendered in memory by deploy-mysql.yml and piped into `mysql` inside the
-- container (never written to disk, the task runs with no_log). Applied on
-- every run, so it is idempotent: re-running with new passwords rotates
-- them, and grants are reset to exactly what is listed here.
--
-- Prod and dev are isolated by database and user: each user only gets
-- database-level privileges on its own databases, so no global SUPER,
-- FILE, PROCESS or GRANT OPTION. `_` is escaped in GRANT because it is a
-- wildcard there.
--
-- The one exception is `enem_monitor` (enem-landing-monitor's DB menu): only
-- the global PROCESS privilege (SHOW PROCESSLIST, SHOW GLOBAL STATUS) and no
-- privilege on any database, so it cannot SELECT application tables.

{% for db in mysql_databases %}
CREATE DATABASE IF NOT EXISTS `{{ db.name }}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
{% endfor %}

{% for user in mysql_users %}
CREATE USER IF NOT EXISTS '{{ user.name }}'@'%' IDENTIFIED BY '{{ user.password }}';
ALTER USER '{{ user.name }}'@'%' IDENTIFIED BY '{{ user.password }}';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM '{{ user.name }}'@'%';
{% for db in mysql_databases if db.user == user.name %}
GRANT ALL PRIVILEGES ON `{{ db.name | replace('_', '\\_') }}`.* TO '{{ user.name }}'@'%';
{% endfor %}
{% endfor %}

{% if mysql_monitor_password | default('') | length > 0 %}
CREATE USER IF NOT EXISTS 'enem_monitor'@'%' IDENTIFIED BY '{{ mysql_monitor_password }}';
ALTER USER 'enem_monitor'@'%' IDENTIFIED BY '{{ mysql_monitor_password }}' WITH MAX_USER_CONNECTIONS 4;
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'enem_monitor'@'%';
GRANT PROCESS ON *.* TO 'enem_monitor'@'%';
{% endif %}

-- root may only log in from inside the container (socket, `docker exec`).
-- MYSQL_ROOT_HOST=localhost already prevents root@'%' on first init; this
-- removes it in case it was ever created by hand.
DROP USER IF EXISTS 'root'@'%';

FLUSH PRIVILEGES;
