# Rendered by deploy-mysql.yml to /opt/enem-landing/mysql/backup.env (0600,
# root). EnvironmentFile of mysql-backup.service. Holds the backup bucket
# credentials, so it must never be committed with real values.

BACKUP_R2_ENDPOINT={{ mysql_backup_r2_endpoint }}
BACKUP_R2_ACCESS_KEY_ID={{ mysql_backup_r2_access_key_id }}
BACKUP_R2_SECRET_ACCESS_KEY={{ mysql_backup_r2_secret_access_key }}
BACKUP_R2_BUCKET={{ mysql_backup_r2_bucket }}
BACKUP_AGE_RECIPIENT={{ mysql_backup_age_recipient }}
BACKUP_NOTIFY_WEBHOOK_URL={{ mysql_backup_notify_webhook_url | default('') }}
BACKUP_DATABASES="{{ mysql_databases | map(attribute='name') | join(' ') }}"
BACKUP_DAILY_KEEP=7d
BACKUP_WEEKLY_KEEP=28d
