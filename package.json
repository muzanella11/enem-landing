{
  "name": "enem-landing",
  "version": "2.1.0",
  "license": "UNLICENSED",
  "scripts": {
    "nx:check": "yarn outdated @nx/devkit @nx/workspace",
    "nx:upgrade": "yarn add nx@latest @nx/devkit@latest @nx/workspace@latest",
    "nx:migrate": "yarn nx migrate latest && yarn nx migrate --run-migrations",
    "nx:full-upgrade": "yarn nx:upgrade && yarn nx:migrate",
    "nx:graph": "yarn nx graph",
    "nx:reset": "yarn nx reset",
    "nx:create:api-apps": "yarn nx g @nx/nest:app",
    "nx:create:web-apps": "yarn nx g @nx/nuxt:app",

    "nx:lint:enem-landing-account-api": "yarn nx lint enem-landing-account-api",
    "nx:lint:enem-landing-account-web": "yarn nx lint enem-landing-account-web",
    "nx:lint:enem-landing-account-web-e2e": "yarn nx lint enem-landing-account-web-e2e",
    "nx:lint:enem-landing-api": "yarn nx lint enem-landing-api",
    "nx:lint:enem-landing-cms": "yarn nx lint enem-landing-cms",
    "nx:lint:enem-landing-cms-e2e": "yarn nx lint enem-landing-cms-e2e",
    "nx:lint:enem-landing-web": "yarn nx lint enem-landing-web",
    "nx:lint:enem-landing-web-e2e": "yarn nx lint enem-landing-web-e2e",
    "lint": "yarn nx run-many -t lint",
    "nx:lint:fix:enem-landing-account-api": "yarn nx lint enem-landing-account-api --fix",
    "nx:lint:fix:enem-landing-account-web": "yarn nx lint enem-landing-account-web --fix",
    "nx:lint:fix:enem-landing-api": "yarn nx lint enem-landing-api --fix",
    "nx:lint:fix:enem-landing-cms": "yarn nx lint enem-landing-cms --fix",
    "nx:lint:fix:enem-landing-web": "yarn nx lint enem-landing-web --fix",
    "lint:fix": "yarn nx run-many -t lint -- --fix",

    "nx:lint:format:enem-landing-account-api": "yarn nx lint:format enem-landing-account-api",
    "nx:lint:format:enem-landing-account-web": "yarn nx lint:format enem-landing-account-web",
    "nx:lint:format:enem-landing-api": "yarn nx lint:format enem-landing-api",
    "nx:lint:format:enem-landing-cms": "yarn nx lint:format enem-landing-cms",
    "nx:lint:format:enem-landing-web": "yarn nx lint:format enem-landing-web",
    "lint:format": "yarn nx run-many -t lint:format",
    "nx:lint:format:fix:enem-landing-account-api": "yarn nx lint:format:fix enem-landing-account-api",
    "nx:lint:format:fix:enem-landing-account-web": "yarn nx lint:format:fix enem-landing-account-web",
    "nx:lint:format:fix:enem-landing-api": "yarn nx lint:format:fix enem-landing-api",
    "nx:lint:format:fix:enem-landing-cms": "yarn nx lint:format:fix enem-landing-cms",
    "nx:lint:format:fix:enem-landing-web": "yarn nx lint:format:fix enem-landing-web",
    "lint:format:fix": "yarn nx run-many -t lint:format:fix",

    "nx:test:enem-landing-account-api": "yarn nx test enem-landing-account-api",
    "nx:test:enem-landing-api": "yarn nx test enem-landing-api",
    "nx:test:enem-landing-cms": "yarn nx test enem-landing-cms",
    "nx:test:enem-landing-web": "yarn nx test enem-landing-web",
    "test": "yarn nx run-many -t test",

    "nx:e2e:enem-landing-account-web": "yarn nx e2e enem-landing-account-web-e2e",
    "nx:e2e:enem-landing-cms": "yarn nx e2e enem-landing-cms-e2e",
    "nx:e2e:enem-landing-web": "yarn nx e2e enem-landing-web-e2e",
    "e2e": "yarn nx:e2e:enem-landing-account-web && yarn nx:e2e:enem-landing-cms && yarn nx:e2e:enem-landing-web",

    "nx:e2e:enem-landing-account-web:serverless": "BASE_URL=http://localhost:8000 yarn nx e2e enem-landing-account-web-e2e",
    "nx:e2e:enem-landing-cms:serverless": "BASE_URL=http://localhost:4000 yarn nx e2e enem-landing-cms-e2e",
    "nx:e2e:enem-landing-web:serverless": "BASE_URL=http://localhost:8001 yarn nx e2e enem-landing-web-e2e",
    "e2e:serverless": "yarn nx:e2e:enem-landing-account-web:serverless && yarn nx:e2e:enem-landing-cms:serverless && yarn nx:e2e:enem-landing-web:serverless",

    "nx:build:enem-landing-account-api": "yarn nx build enem-landing-account-api",
    "nx:build:enem-landing-account-web": "yarn nx build enem-landing-account-web",
    "nx:build:enem-landing-api": "yarn nx build enem-landing-api",
    "nx:build:enem-landing-cms": "yarn nx build enem-landing-cms",
    "nx:build:enem-landing-web": "yarn nx build enem-landing-web",
    "build": "yarn nx run-many -t build -p enem-landing-account-api enem-landing-account-web enem-landing-api enem-landing-cms enem-landing-web",

    "nx:serve:enem-landing-account-api": "yarn nx run enem-landing-account-api:serve",
    "nx:serve:enem-landing-account-web": "yarn nx run enem-landing-account-web:serve",
    "nx:serve:enem-landing-api": "yarn nx run enem-landing-api:serve",
    "nx:serve:enem-landing-cms": "yarn nx run enem-landing-cms:serve",
    "nx:serve:enem-landing-web": "yarn nx run enem-landing-web:serve",
    "dev": "yarn nx run-many -t serve -p enem-landing-account-api enem-landing-account-web enem-landing-api enem-landing-cms enem-landing-web --parallel=5 --outputStyle=stream",
    "dev:account": "yarn nx run-many -t serve -p enem-landing-account-api enem-landing-account-web --parallel=2 --outputStyle=stream",
    "dev:core": "yarn nx run-many -t serve -p enem-landing-api enem-landing-web --parallel=2 --outputStyle=stream",
    "dev:cms": "yarn nx run-many -t serve -p enem-landing-cms --parallel=1 --outputStyle=stream",

    "nx:migration:run:enem-landing-account-api": "yarn nx run enem-landing-account-api:migration:run",
    "nx:migration:revert:enem-landing-account-api": "yarn nx run enem-landing-account-api:migration:revert",
    "nx:migration:run:enem-landing-api": "yarn nx run enem-landing-api:migration:run",
    "nx:migration:revert:enem-landing-api": "yarn nx run enem-landing-api:migration:revert",
    "migration": "yarn nx:migration:run:enem-landing-account-api && yarn nx:migration:run:enem-landing-api",

    "nx:seed:run:enem-landing-account-api": "yarn nx run enem-landing-account-api:seed",
    "nx:seed:run:enem-landing-api": "yarn nx run enem-landing-api:seed",
    "seed": "yarn nx:seed:run:enem-landing-account-api && yarn nx:seed:run:enem-landing-api",

    "prod:enem-landing-account-api": "node apps/enem-landing-account-api/dist/main.js",
    "prod:enem-landing-account-web": "NITRO_PORT=8000 node apps/enem-landing-account-web/.output/server/index.mjs",
    "prod:enem-landing-api": "node apps/enem-landing-api/dist/main.js",
    "prod:enem-landing-cms": "NITRO_PORT=4000 node apps/enem-landing-cms/.output/server/index.mjs",
    "prod:enem-landing-web": "NITRO_PORT=8001 node apps/enem-landing-web/.output/server/index.mjs",
    "prod:prepare": "yarn build",

    "ports:kill": "bash scripts/kill-ports.sh",
    "nx:libs:create": "bash scripts/create-library.sh",
    "nx:libs:nest:create": "bash scripts/generate-nest-libs-component.sh",
    "nx:apps:create": "bash scripts/create-app.sh",
    "nx:apps:delete": "bash scripts/delete-app.sh"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@mdi/font": "^7.4.47",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.9.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "cronstrue": "^3.24.0",
    "ioredis": "^6.0.0",
    "moment-timezone": "^0.6.3",
    "multer": "^2.3.0",
    "mysql2": "^3.24.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pinia": "^2.3.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.31",
    "typeorm-extension": "^3.9.0",
    "vuetify": "^4.1.12",
    "vuetify-nuxt-module": "^1.0.0-rc.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nuxt/devtools": "^3.0.0",
    "@nuxt/eslint-config": "^1.10.0",
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/ui-templates": "^1.3.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/nuxt": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "~4.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "h3": "^1.8.2",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nuxt": "^4.0.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "sass": "^1.83.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/*/*"
  ]
}
