PORT=3001
CORS_ORIGIN=http://localhost:4000,http://localhost:8001

# Aiven MySQL (or local MySQL in dev) — see issues/10-infra-cicd.md
DATABASE_URL=mysql://user:user@localhost:3306/enem_landing_api

# Base URL of enem-landing-account-api — used by SsoAuthGuard (libs/backend/sso)
# to validate tokens on admin endpoints.
SSO_HOST=http://localhost:3000
