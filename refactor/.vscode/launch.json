{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug tmp-probe-api with Nx",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["nx", "serve", "tmp-probe-api"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/tmp-probe-api/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug enem-landing-account with Nx",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["nx", "serve", "enem-landing-account"],
      "env": {
        "NODE_OPTIONS": "--inspect=9230"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/enem-landing-account/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    }
  ]
}
